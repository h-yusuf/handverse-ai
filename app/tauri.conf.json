{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HANDVERSE",
  "version": "1.0.0",
  "identifier": "studio.handverse.arcade",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HANDVERSE",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#090b13",
        "focus": false,
        "create": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
